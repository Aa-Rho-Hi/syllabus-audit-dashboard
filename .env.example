# ---- Google Drive ----
# Professors paste any folder link in the app and click "Sign in with Google".
# This is the OAuth Client ID (Web application) from Google Cloud. It's public, not a secret.
GOOGLE_CLIENT_ID=
# Optional: link that's pre-filled the first time someone opens the app
# DRIVE_FOLDER_LINK=https://drive.google.com/drive/folders/1iJc1s2O7HN4PRhlrGxBdDM8B8a1mtsOQ
# Optional fallbacks (only if you don't want professors to sign in):
#   service account, for folders shared with its email
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#   API key, for folders set to "Anyone with the link"
# GOOGLE_API_KEY=

# ---- Fixed department folder (faculty don't sign in or paste links) ----
# DRIVE_FOLDER_LINK=https://drive.google.com/drive/folders/...
# Locally, let the app use your own Google login for it:
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/cloud-platform
# USE_DEFAULT_CREDENTIALS=1

# ---- LLM (leave blank and the app runs on regex only) ----
LLM_PROVIDER=anthropic          # anthropic | openai  (openai also works for any OpenAI-compatible API)
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5    # default for anthropic; gpt-4o-mini for openai
# LLM_BASE_URL=                 # only for OpenAI-compatible providers (Groq, Azure, local, etc.)
# LLM_TIMEOUT=25

# ---- Testing without Drive ----
# LOCAL_SYLLABI_DIR=./sample_syllabi
